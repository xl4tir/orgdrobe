{
  // Static-assets deployment for Cloudflare Workers (used by `npx wrangler deploy`).
  // Separate worker so the editorial design lives at its own workers.dev URL.
  "name": "orgdrobe-editorial",
  "compatibility_date": "2024-11-01",
  // Enable the free orgdrobe.<subdomain>.workers.dev URL.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Serve index.html for any unmatched route so client-side routing works.
    "not_found_handling": "single-page-application"
  }
}
